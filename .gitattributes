* text=auto
/.gitattributes text eol=lf
/.gitignore text eol=lf

# Source and documentation use stable LF line endings.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf

# PowerShell scripts use Windows line endings.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Model and office formats are binary.
*.glb binary
*.step binary
*.stp binary
*.wasm binary
*.xlsx binary
*.xls binary
*.zip binary
