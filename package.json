{
  "name": "gerber-3d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "python server/kingdee_server.py --port 8765",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "models:import": "python scripts/extract-3dmodels-archive.py",
    "models:convert": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/convert-step-models.ps1",
    "preview": "python server/kingdee_server.py --port 4173",
    "test:server": "python -m unittest discover -s server -p test_*.py -v"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.175.0",
    "web-gerber": "^1.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
